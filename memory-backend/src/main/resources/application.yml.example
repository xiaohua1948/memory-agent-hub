server:
  port: 8088
spring:
  servlet:
    multipart:
      # 分片上传下每个请求只携带单个分片（默认 5MB），因此这里只需略大于分片大小即可，
      # 单文件大小上限改由 upload.max-file-size 控制，从而支持 GB 级文件而不抬高单请求内存占用。
      max-file-size: 10MB
      max-request-size: 10MB
      enabled: true
  application:
    name: memory-backend
  #mysql配置
  datasource:
      driver-class-name: com.mysql.cj.jdbc.Driver
      url: ${MYSQL_URL:jdbc:mysql://localhost:3306/memory_space}
      username: ${MYSQL_USERNAME:root}
      password: ${MYSQL_PASSWORD:123456}
  #redis配置
  data:
      redis:
        host: ${REDIS_HOST:localhost}
        port: ${REDIS_PORT:6379}
        password: ${REDIS_PASSWORD:123456}
        database: 0
  #邮箱配置
  mail:
      host: smtp.qq.com
      port: 465
      username: your-qq-email@qq.com
      password: YOUR_EMAIL_AUTH_CODE
      default-encoding: utf-8
      protocol: smtps
      code:
        time: 300
#mybatis-plus配置
mybatis-plus:
  configuration:
    map-underscore-to-camel-case: true
    log-impl: org.apache.ibatis.logging.stdout.StdOutImpl
  global-config:
    db-config:
      id-type: ASSIGN_ID
      logic-delete-field: deleted
      logic-not-delete-value: 0
      logic-delete-value: 1
    banner: false
  mapper-locations: classpath:/mapper/*.xml
#sa-token配置
sa-token:
    token-name: Authorization
    timeout: 2592000
    active-timeout: -1
    is-concurrent: false
    is-share: true
    token-style: uuid
    is-log: true
    is-read-cookie: false
    jwt-secret-key: xiaohua
    is-read-header: true
#minio oss配置
minio:
  access-key: ${MINIO_ACCESS_KEY:CHANGE_MINIO_ACCESS_KEY}
  secret-key: ${MINIO_SECRET_KEY:CHANGE_MINIO_SECRET_KEY}
  url: ${MINIO_URL:http://127.0.0.1:9000}
  bucket-name: ${MINIO_BUCKET_NAME:pictures}
  # 浏览器可访问的 MinIO 地址（用于替换预签名URL中的endpoint），Docker 部署时配置，如 http://127.0.0.1:9002
  public-url: ${MINIO_PUBLIC_URL:}
#分片上传配置（与前端 constants 保持一致）
upload:
  # 分片大小，5MB。S3/MinIO multipart 要求除最后一片外每片不小于 5MB
  chunk-size: 5242880
  # 单文件最大 2GB
  max-file-size: 2147483648
  # 合并后是否校验整体 MD5
  md5-verify-enabled: true
  # 超过该大小则跳过服务端全量 MD5 校验，避免合并接口长时间阻塞
  md5-verify-max-size: 209715200
  # 上传任务有效期（小时），超时未完成将被定时任务清理
  task-ttl-hours: 24
  # 单用户并发上传任务数上限
  max-concurrent-tasks: 5
  # 图片超过该大小才压缩缩略图，小图直接复用原图
  thumbnail-threshold: 512000
  # 缩略图长边像素
  thumbnail-max-size: 512
  # 缩略图质量 0~1
  thumbnail-quality: 0.75

#阿里OSS配置
aliyun:
  oss:
    endpoint: oss-cn-beijing.aliyuncs.com
    accessKeyId: YOUR_ALIYUN_ACCESS_KEY_ID
    accessKeySecret: YOUR_ALIYUN_ACCESS_KEY_SECRET
    bucketName: memory-pictures
springdoc:
    api-docs:
      enabled: true
    swagger-ui:
      path: /swagger-ui.html
      enabled: true
# 高德API_KEY
amp:
  api:
    key: YOUR_AMAP_API_KEY
  geo:
    url: https://restapi.amap.com/v3/geocode/regeo
#opencv训练的数据模型
opencv:
  native:
    dll-path: "opencv/lib/x64/opencv_java455.dll"
    haar-model: "opencv/haarcascades/haarcascade_frontalface_alt2.xml"
    linux-dll-path: ${OPENCV_LINUX_DLL_PATH:}
huawei:
  cloud:
    image:
      ak: YOUR_HUAWEI_CLOUD_AK
      sk: YOUR_HUAWEI_CLOUD_SK
      region: cn-north-4
      endpoint: image.cn-north-4.myhuaweicloud.com
      threshold: 10
      language: zh

# CORS 白名单（2.10 修复）：逗号分隔允许的前端 origin，留空则关闭凭据跨域（本地开发）
# 生产环境示例：http://127.0.0.1:8081,http://127.0.0.1:8083,https://your-domain.com
cors:
  allowed-origins: ${CORS_ALLOWED_ORIGINS:}
