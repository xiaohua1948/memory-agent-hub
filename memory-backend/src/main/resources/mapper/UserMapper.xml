<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.memory.xiaohua.mapper.UserMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.memory.xiaohua.model.entity.User">
        <id column="id" property="id" />
        <result column="userName" property="userName" />
        <result column="account" property="account" />
        <result column="role" property="role" />
        <result column="passWord" property="passWord" />
        <result column="email" property="email" />
        <result column="createTime" property="createTime" />
        <result column="updateTime" property="updateTime" />
        <result column="profile" property="profile" />
        <result column="avatarUrl" property="avatarUrl" />
        <result column="avatarObjectName" property="avatarObjectName" />
    </resultMap>












    <select id="selectAllUserInfo" resultType="com.memory.xiaohua.model.vo.entity.UserInfoVO">
        SELECT
        u.id AS userId,
        u.user_name AS userName,
        u.account,
        u.email,
        u.role,
        u.create_time,
        u.update_time,
        u.profile,
        u.avatar_url,
        us.total_space AS totalSpace,
        us.used_space AS usedSpace,
        us.account_status AS accountStatus,
        us.membership_days AS membershipDays
        FROM user u
        INNER JOIN user_storage us ON u.id = us.user_id
       where
                u.role = 'user'

    </select>


    <select id="selectAllAdmin" resultType="com.memory.xiaohua.model.vo.entity.UserInfoVO">
        SELECT u.id        AS userId,
               u.user_name AS userName,
               u.account,
               u.email,
               u.role,
               u.create_time,
               u.update_time,
               u.profile,
               u.avatar_url
        from user as u
        where u.role = 'admin'

    </select>

</mapper>
