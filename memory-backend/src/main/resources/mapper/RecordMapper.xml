<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.memory.xiaohua.mapper.RecordMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.memory.xiaohua.model.entity.Record">
        <id column="id" property="id" />
        <result column="operation_time" property="operationTime" />
        <result column="operation" property="operation" />
        <result column="number" property="number" />
        <result column="ipv4" property="ipv4" />
        <result column="userId" property="userId" />
    </resultMap>

    <select id="selectOperationStats" resultType="com.memory.xiaohua.model.vo.visual.MemoryVO">
        SELECT
            COUNT(*) AS visitCount,
            COALESCE(SUM(CASE WHEN operation LIKE CONCAT('%', #{downloadKey}, '%') THEN number END), 0) AS downloadCount,
            COALESCE(SUM(CASE WHEN operation LIKE CONCAT('%', #{uploadKey}, '%') THEN number END), 0) AS uploadCount
        FROM record
    </select>

</mapper>
