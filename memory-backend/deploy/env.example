# ============================================================
# 生产环境变量模板
#
# 使用方式：
#   1. 复制本文件为 env.prod（该文件已被 .gitignore 忽略，请勿提交）
#      cp env.example env.prod
#   2. 填入真实密钥
#   3. 上传到服务器，例如 /opt/memory/env.prod
#   4. 在服务器上设置权限，仅允许运行应用的用户读取
#      chmod 600 /opt/memory/env.prod
#      chown memory:memory /opt/memory/env.prod
#
# 安全要求：
#   - 本模板可以提交；填好真实值的 env.prod 绝对禁止提交
#   - 密钥泄露后请立即到对应云厂商控制台轮换
# ============================================================

# ---------- MySQL ----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=memory_space
MYSQL_USERNAME=
MYSQL_PASSWORD=

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------- 邮件 ----------
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_CODE_TIME=300

# ---------- Sa-Token ----------
# 请使用足够长的随机字符串，例如：openssl rand -hex 32
SA_TOKEN_JWT_SECRET=

# ---------- MinIO ----------
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_URL=http://127.0.0.1:9000
MINIO_BUCKET=pictures

# ---------- 阿里云 OSS ----------
ALIYUN_OSS_ENDPOINT=
ALIYUN_OSS_ACCESS_KEY=
ALIYUN_OSS_SECRET_KEY=
ALIYUN_OSS_BUCKET=

# ---------- 高德地图 ----------
AMAP_API_KEY=

# ---------- 华为云图像识别 ----------
HUAWEI_CLOUD_AK=
HUAWEI_CLOUD_SK=
HUAWEI_CLOUD_REGION=cn-north-4
HUAWEI_CLOUD_IMAGE_ENDPOINT=image.cn-north-4.myhuaweicloud.com
