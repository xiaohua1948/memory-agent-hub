# =============================================================
# Memory Agent Hub - Docker 部署环境变量（模板）
# 复制为 .env 后填入真实值：cp .env.example .env
# 修改后执行: docker compose --env-file .env up -d
# =============================================================

# ---------- 宿主机端口（默认避开本地已占用的 3306/6379/9000/8088） ----------
MYSQL_PORT=3307
REDIS_PORT=6380
MINIO_API_PORT=9002
MINIO_CONSOLE_PORT=9003
ROCKETMQ_NAMESRV_PORT=9876
ROCKETMQ_BROKER_PORT=10911
ROCKETMQ_DASHBOARD_PORT=8082
BACKEND_PORT=8089
FRONTEND_PORT=8081
ADMIN_PORT=8083

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=change_me
MYSQL_DATABASE=memory_space

# ---------- Redis ----------
REDIS_PASSWORD=change_me

# ---------- Apache RocketMQ（通用异步任务消息队列，namesrv: ROCKETMQ_NAMESRV_PORT / broker: ROCKETMQ_BROKER_PORT / dashboard: ROCKETMQ_DASHBOARD_PORT） ----------
ROCKETMQ_PRODUCER_GROUP=memory-producer-group

# ---------- MinIO ----------
# 请使用强随机凭据，后端 application.yml 需同步
MINIO_ROOT_USER=CHANGE_MINIO_ACCESS_KEY
MINIO_ROOT_PASSWORD=CHANGE_MINIO_SECRET_KEY
# 浏览器与后端生成预签名 URL 必须共用同一 host（签名与 host 绑定），
# 因此使用 host.docker.internal（Docker Desktop 默认可解析为宿主），
# 而不是 127.0.0.1，否则签名校验失败导致图片打不开。
MINIO_PUBLIC_URL=http://host.docker.internal:9002

# ---------- 管理后台 API 地址（浏览器访问后端） ----------
# 后端服务停止后，可改为 http://127.0.0.1:8088 并重新构建 admin
ADMIN_API_URL=http://127.0.0.1:8089

# ---------- 数据卷挂载根目录 ----------
DATA_DIR=./data
